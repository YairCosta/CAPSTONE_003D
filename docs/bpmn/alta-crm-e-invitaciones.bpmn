      <bpmndi:BPMNEdge id="Flujo_9_di" bpmnElement="Flujo_9">
        <di:waypoint x="1507" y="519" />
        <di:waypoint x="1545" y="519" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_10_di" bpmnElement="Flujo_10">
        <di:waypoint x="1683" y="519" />
        <di:waypoint x="1702" y="519" />
        <di:waypoint x="1702" y="349" />
        <di:waypoint x="1721" y="349" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_11_di" bpmnElement="Flujo_11">
        <di:waypoint x="1859" y="349" />
        <di:waypoint x="1878" y="349" />
        <di:waypoint x="1878" y="689" />
        <di:waypoint x="1897" y="689" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_12_di" bpmnElement="Flujo_12">
        <di:waypoint x="2035" y="689" />
        <di:waypoint x="2123" y="689" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
