# Fuentes oficiales de las zonas (se descargan; solo se versiona el resultado procesado). El SQL
# generado tampoco: queda dentro de la migración que lo carga.
datos/zonas/fuentes/
datos/zonas/zone_catalog.sql
datos/zonas/sql/
# De los países de geoBoundaries solo se versiona la migración (el dato); Chile y Perú, además su
# GeoJSON, que usan las pruebas
datos/zonas/zonas-*.geojson
!datos/zonas/zonas-cl.geojson
!datos/zonas/zonas-pe.geojson
