# =============================================================================
# VARIABLES DE ENTORNO: CRM GEOESTRATÉGICO (SUPABASE + GOOGLE MAPS)
# =============================================================================

# 1. Supabase (Backend & Database)
# URL y clave pública (anon / publishable): pueden ir en el navegador, los datos los protege RLS
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase
# De dónde salen los datos: demo (en memoria, por defecto) o supabase (login y administración reales).
# En desarrollo, ?demo o ?pruebas en la URL fuerzan la demo aunque aquí diga supabase.
VITE_DATA_SOURCE=demo

# 1b. Invitaciones de usuarios (servidor; NUNCA con prefijo VITE_ ni en el repositorio)
# Clave secreta (service_role / secret key) de Supabase → Project Settings → API Keys.
# Salta RLS: solo la usa server/adminUsers.ts para invitar. Si falta, invitar responde 503.
# SUPABASE_SERVICE_ROLE_KEY=
# Dirección a la que vuelve el enlace del correo de invitación (también en Supabase →
# Authentication → URL Configuration: Site URL y Redirect URLs)
# APP_URL=http://localhost:5173

# 2. Google Maps Platform
# Clave con APIs habilitadas: Maps JavaScript API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...

# 3. Supabase Edge Function Secrets (Configuradas con: supabase secrets set)
# GOOGLE_MAPS_API_KEY=AIzaSy...
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# 4. Asistente IA de prospección (servidor; NO usar prefijo VITE_)
# Proveedor: gemini (por defecto) u openai
AI_PROVIDER=gemini
# Gemini. API key gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu-clave-de-gemini
GEMINI_MODEL=gemini-2.5-flash
# OpenAI (GPT). Clave de API de https://platform.openai.com/api-keys con saldo cargado.
# La suscripción de ChatGPT NO sirve: es otra cuenta y no da acceso a la API.
# OPENAI_API_KEY=tu-clave-de-openai
# OPENAI_MODEL=gpt-5-mini
# Opcional: resultados reales de empresas (Google Places API)
# GOOGLE_PLACES_API_KEY=
