# ============================================================================
# Variables de entorno de Revela
# ============================================================================
# En local: copia este archivo como .env.local (nunca se sube al repositorio).
# Publicada: las mismas variables van en Vercel → Settings → Environment Variables
# (ver docs/DESPLIEGUE.md). Las que empiezan con VITE_ quedan dentro de la app y son públicas;
# las demás solo existen en el servidor. Ninguna clave se escribe en el código.

# 1. Supabase
# URL y clave pública (anon / publishable): pueden ir en el navegador, los datos los protege RLS
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-de-supabase
# De dónde salen los datos: demo (en memoria, por defecto) o supabase (login y datos reales).
# En desarrollo, ?demo o ?pruebas en la URL fuerzan la demo aunque aquí diga supabase.
VITE_DATA_SOURCE=demo

# 2. Invitaciones de usuarios (servidor; NUNCA con prefijo VITE_)
# Clave secreta (service_role / secret key) de Supabase → Project Settings → API Keys.
# Salta RLS: solo la usa server/adminUsers.ts para invitar. Si falta, invitar responde 503.
# En Vercel, márcala como Sensitive.
# SUPABASE_SERVICE_ROLE_KEY=
# Dirección a la que vuelve el enlace del correo de invitación: http://localhost:5173 en local,
# la dirección publicada en Vercel. También va en Supabase → Authentication → URL Configuration.
# APP_URL=http://localhost:5173

# 3. Asistente IA de prospección (servidor; NUNCA con prefijo VITE_)
# Proveedor: openai (GPT, el único que se usa). Gemini está apagado: solo se enciende con AI_PROVIDER=gemini
# AI_PROVIDER=openai
# Gemini (apagado). API key gratuita: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OpenAI (GPT). Clave de API de https://platform.openai.com/api-keys con saldo cargado.
# La suscripción de ChatGPT NO sirve: es otra cuenta y no da acceso a la API.
# OPENAI_API_KEY=
# Modelo: gpt-5-nano (el más barato, predeterminado), gpt-5-mini, gpt-4.1-nano, gpt-4.1-mini o gpt-4o-mini
# OPENAI_MODEL=gpt-5-nano
# Los GPT-5 razonan antes de responder y eso se cobra: minimal es lo más barato
# OPENAI_REASONING_EFFORT=minimal
# Presupuesto mensual de IA de cada CRM en dólares (predeterminado 30); la gerencia lo ajusta desde el chat
# AI_DEFAULT_MONTHLY_BUDGET_USD=30
# Opcional: resultados reales de empresas (Google Places API)
# GOOGLE_PLACES_API_KEY=
